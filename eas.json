{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preprod": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "preprod"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "beta": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "prod"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "prod"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "companyName": "R DIGITAL INSTORE",
        "appleTeamId": "7K7YZBGK62",
        "appName": "Dualia",
        "language": "fr-FR",
        "sku": "dualia-ios"
      }
    }
  }
}
